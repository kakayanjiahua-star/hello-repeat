    "text": "don't forget to turn off the screen when leaving."
  },
  {
    "id": "c50",
    "startMs": 194040,
    "endMs": 195280,
    "text": "If you want to face a challenge,"
  },
  {
    "id": "c51",
    "startMs": 196400,
    "endMs": 197740,
    "text": "Like learning to take photos,"
  },
  {
    "id": "c52",
