    "endMs": 199620,
    "text": "practice a lot,"
  },
  {
    "id": "c53",
    "startMs": 200460,
    "endMs": 202840,
    "text": "try your best and never give up."
  },
  {
    "id": "c54",
    "startMs": 203940,
    "endMs": 206680,
    "text": "These more actions help us make the world better."
