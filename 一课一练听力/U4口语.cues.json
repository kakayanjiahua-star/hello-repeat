[
  {
    "id": "c1",
    "startMs": 420,
    "endMs": 5420,
    "text": "Unit 4. Exercise for speaking."
  },
  {
    "id": "c2",
    "startMs": 6100,
    "endMs": 6740,
    "text": "Koyu Lin-si."
  },
  {
    "id": "c3",
    "startMs": 7660,
    "endMs": 9120,
    "text": "1. Read aloud."
  },
  {
    "id": "c4",
    "startMs": 11080,
    "endMs": 12500,
    "text": "A bear with black fur,"
  },
  {
    "id": "c5",
    "startMs": 13160,
    "endMs": 14200,
    "text": "so rare to see."
  },
  {
    "id": "c6",
    "startMs": 15040,
    "endMs": 15880,
    "text": "Lives near the woods,"
  },
  {
    "id": "c7",
    "startMs": 16460,
    "endMs": 17820,
    "text": "where tall trees be."
  },
  {
    "id": "c8",
    "startMs": 18680,
    "endMs": 20580,
    "text": "It climbs upstairs made of stones,"
  },
  {
    "id": "c9",
    "startMs": 21540,
    "endMs": 22780,
    "text": "to find some sweet berries,"
  },
  {
    "id": "c10",
    "startMs": 23360,
    "endMs": 24300,
    "text": "all on its own."
  },
  {
    "id": "c11",
    "startMs": 26760,
    "endMs": 28140,
    "text": "A bear with black fur,"
  },
  {
    "id": "c12",
    "startMs": 28780,
    "endMs": 29840,
    "text": "so rare to see,"
  },
  {
    "id": "c13",
    "startMs": 30640,
    "endMs": 31520,
    "text": "lives near the woods,"
  },
  {
    "id": "c14",
    "startMs": 32100,
    "endMs": 33420,
    "text": "where tall trees be."
  },
  {
    "id": "c15",
    "startMs": 34300,
    "endMs": 36200,
    "text": "It climbs upstairs made of stones,"
  },
  {
    "id": "c16",
    "startMs": 37140,
    "endMs": 38400,
    "text": "to find some sweet berries,"
  },
  {
    "id": "c17",
    "startMs": 38980,
    "endMs": 39920,
    "text": "all on its own."
  },
  {
    "id": "c18",
    "startMs": 42240,
    "endMs": 43300,
    "text": "2."
  },
  {
    "id": "c19",
    "startMs": 44320,
    "endMs": 44820,
    "text": "Read and say,"
  },
  {
    "id": "c20",
    "startMs": 46280,
    "endMs": 49180,
    "text": "I should take a hat to keep me cool and comfortable."
  },
  {
    "id": "c21",
    "startMs": 50300,
    "endMs": 54140,
    "text": "I also need to take closed toe shoes to protect my feet."
  },
  {
    "id": "c22",
    "startMs": 56520,
    "endMs": 59500,
    "text": "I should take a hat to keep me cool and comfortable."
  },
  {
    "id": "c23",
    "startMs": 60580,
    "endMs": 64420,
    "text": "I also need to take closed toe shoes to protect my feet."
  },
  {
    "id": "c24",
    "startMs": 66760,
    "endMs": 69200,
    "text": "I need to bring a water bottle and an"
  },
  {
    "id": "c25",
    "startMs": 69200,
    "endMs": 72020,
    "text": "umbrella and do not forget to take them home."
  },
  {
    "id": "c26",
    "startMs": 73780,
    "endMs": 76540,
    "text": "I need to bring a water bottle and an"
  },
  {
    "id": "c27",
    "startMs": 76540,
    "endMs": 79440,
    "text": "umbrella and do not forget to take them home."
  },
  {
    "id": "c28",
    "startMs": 81220,
    "endMs": 81680,
    "text": "4."
  },
  {
    "id": "c29",
    "startMs": 82700,
    "endMs": 83520,
    "text": "Read and enjoy."
  },
  {
    "id": "c30",
    "startMs": 86080,
    "endMs": 87140,
    "text": "What a wonderful world!"
  },
  {
    "id": "c31",
    "startMs": 88220,
    "endMs": 90280,
    "text": "I see trees and flowers too."
  },
  {
    "id": "c32",
    "startMs": 91180,
    "endMs": 93360,
    "text": "I see them bloom for me and you."
  },
  {
    "id": "c33",
    "startMs": 94080,
    "endMs": 94920,
    "text": "And I think to myself,"
  },
  {
    "id": "c34",
    "startMs": 95580,
    "endMs": 96710,
    "text": "what a wonderful world!"
  },
  {
    "id": "c35",
    "startMs": 97620,
    "endMs": 99280,
    "text": "I see a cat and a dog."
  },
  {
    "id": "c36",
    "startMs": 100220,
    "endMs": 101800,
    "text": "Living side by side."
  },
  {
    "id": "c37",
    "startMs": 102700,
    "endMs": 105180,
    "text": "They teach us love and never hide."
  },
  {
    "id": "c38",
    "startMs": 106340,
    "endMs": 109320,
    "text": "What a wonderful world!"
  },
  {
    "id": "c39",
    "startMs": 110280,
    "endMs": 112420,
    "text": "I see trees and flowers too."
  },
  {
    "id": "c40",
    "startMs": 113360,
    "endMs": 115500,
    "text": "I see them bloom for me and you."
  },
  {
    "id": "c41",
    "startMs": 116240,
    "endMs": 117040,
    "text": "And I think to myself,"
  },
  {
    "id": "c42",
    "startMs": 117680,
    "endMs": 118830,
    "text": "what a wonderful world."
  },
  {
    "id": "c43",
    "startMs": 119720,
    "endMs": 123960,
    "text": "I see a cat and a dog living side by side."
  },
  {
    "id": "c44",
    "startMs": 124820,
    "endMs": 127320,
    "text": "They teach us love and never hide."
  },
  {
