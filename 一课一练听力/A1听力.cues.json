    "endMs": 340100,
    "text": "You only need two things."
  },
  {
    "id": "c109",
    "startMs": 340960,
    "endMs": 343380,
    "text": "A big pot and some thin arrows."
  },
  {
    "id": "c110",
    "startMs": 344760,
    "endMs": 346760,
    "text": "First, find a safe place."
  },
  {
    "id": "c111",
    "startMs": 347840,
    "endMs": 351140,
    "text": "Players stand 3 to 4 meters away from the pot."
  },
  {
    "id": "c112",
    "startMs": 352240,
    "endMs": 353460,
    "text": "Don't stand too close."
  },
  {
    "id": "c113",
    "startMs": 354740,
    "endMs": 356300,
    "text": "Take turns to throw the arrows."
  },
  {
    "id": "c114",
    "startMs": 357360,
    "endMs": 360060,
    "text": "Try your best to get the arrows into the pot."
  },
  {
    "id": "c115",
    "startMs": 361740,
    "endMs": 363180,
    "text": "Every time your arrow goes in,"
  },
  {
    "id": "c116",
    "startMs": 363620,
    "endMs": 364780,
    "text": "you get one point."
  },
  {
    "id": "c117",
    "startMs": 366040,
    "endMs": 367760,
    "text": "Play for 5 or 10 rounds."
  },
  {
    "id": "c118",
    "startMs": 368880,
    "endMs": 371220,
    "text": "After all rounds, count your points."
  },
  {
    "id": "c119",
    "startMs": 372080,
    "endMs": 373920,
    "text": "The player with the most points wins."
  },
  {
    "id": "c120",
    "startMs": 375480,
    "endMs": 376100,
    "text": "Long ago,"
  },
  {
    "id": "c121",
    "startMs": 376320,
    "endMs": 378760,
    "text": "Chinese people loved playing Pitchpot too."
  },
  {
    "id": "c122",
    "startMs": 379740,
