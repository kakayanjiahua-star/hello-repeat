    "id": "c60",
    "startMs": 242400,
    "endMs": 242820,
    "text": "For example,"
  },
  {
    "id": "c61",
    "startMs": 243760,
    "endMs": 246120,
    "text": "Chinese ink painting has a long history."
  },
  {
    "id": "c62",
    "startMs": 247160,
    "endMs": 248200,
    "text": "That sounds interesting."
  },
  {
    "id": "c63",
