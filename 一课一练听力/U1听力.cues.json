    "id": "c40",
    "startMs": 198590,
    "endMs": 202500,
    "text": "I'm thinking about joining a club this term."
  },
  {
    "id": "c41",
    "startMs": 203300,
    "endMs": 204420,
    "text": "There are so many clubs."
  },
  {
    "id": "c42",
    "startMs": 205340,
    "endMs": 206760,
    "text": "What club do you think I should join?"
  },
  {
    "id": "c43",
    "startMs": 207040,
    "endMs": 207140,
    "text": "Well,"
  },
  {
    "id": "c44",
    "startMs": 208280,
    "endMs": 209560,
    "text": "there's the music club,"
  },
  {
    "id": "c45",
