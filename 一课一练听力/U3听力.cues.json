  },
  {
    "id": "c104",
    "startMs": 343320,
    "endMs": 343580,
    "text": "Lastly,"
  },
  {
    "id": "c105",
    "startMs": 344580,
    "endMs": 345580,
    "text": "let's talk about cabbage."
  },
  {
    "id": "c106",
    "startMs": 346960,
    "endMs": 349040,
    "text": "The leaves of cabbage can tell us about the"
  },
  {
    "id": "c107",
