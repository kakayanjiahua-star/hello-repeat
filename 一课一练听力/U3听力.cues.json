  {
    "id": "c113",
    "startMs": 364460,
    "endMs": 366280,
    "text": "I hope you've learned something new about plants"
  },
  {
    "id": "c114",
    "startMs": 366660,
    "endMs": 367580,
    "text": "and weather forecasting."
  },
  {
    "id": "c115",
    "startMs": 371380,
    "endMs": 373020,
    "text": "5. Listen and Choose"
  },
  {
    "id": "c116",
    "startMs": 373220,
    "endMs": 377280,
    "text": "Le ji jiying xiao poo xiao cian huang chu"
  },
  {
    "id": "c117",
    "startMs": 377280,
    "endMs": 378800,
    "text": "huang chu huang chu huang chu huang chu huang"
  },
  {
    "id": "c118",
    "startMs": 378800,
    "endMs": 379580,
    "text": "chu huang chu huang chu huang chu huang"
  },
  {
    "id": "c119",
    "startMs": 379580,
    "endMs": 379790,
    "text": "chu huang chu huang chu huang chu huang."
  },
  {
    "id": "c120",
    "startMs": 382760,
    "endMs": 386920,
    "text": "Sao poo xiao cian and xiao tian are visiting the botanical gardens."
  },
  {
    "id": "c121",
    "startMs": 388200,
    "endMs": 388640,
    "text": "Wow!"
  },
  {
    "id": "c122",
    "startMs": 389360,
    "endMs": 390880,
    "text": "The tulips are so beautiful."
  },
  {
    "id": "c123",
    "startMs": 391840,
    "endMs": 393840,
    "text": "Their bright colors are really eye-catching."
  },
  {
    "id": "c124",
    "startMs": 394940,
    "endMs": 396800,
    "text": "This one looks like an ice cream cone."
  },
  {
    "id": "c125",
    "startMs": 397760,
    "endMs": 399720,
    "text": "It has a long stem and big leaves."
  },
  {
    "id": "c126",
    "startMs": 400880,
    "endMs": 403400,
    "text": "The long stem helps the tulip stand up straight."
  },
  {
    "id": "c127",
    "startMs": 404460,
    "endMs": 406180,
    "text": "The big leaves can catch a lot of"
  },
  {
    "id": "c128",
    "startMs": 406180,
    "endMs": 408020,
    "text": "sunlight to make food for the plant."
  },
  {
    "id": "c129",
    "startMs": 409180,
    "endMs": 410360,
    "text": "Look at the name tag."
  },
  {
    "id": "c130",
    "startMs": 411600,
    "endMs": 413840,
    "text": "It's called an ice cream tulip."
  },
  {
    "id": "c131",
    "startMs": 414400,
    "endMs": 414960,
    "text": "How lovely!"
  },
  {
    "id": "c132",
    "startMs": 415900,
    "endMs": 418280,
    "text": "The special shape of this tulip may make it"
  },
  {
    "id": "c133",
    "startMs": 418280,
    "endMs": 421380,
    "text": "easier for insects to land on it and help"
  },
  {
    "id": "c134",
    "startMs": 421380,
    "endMs": 422080,
    "text": "with pollination."
  },
  {
    "id": "c135",
    "startMs": 422780,
    "endMs": 422880,
    "text": "Look,"
  },
  {
    "id": "c136",
    "startMs": 423960,
    "endMs": 425360,
    "text": "the wall is covered with plants."
  },
  {
    "id": "c137",
    "startMs": 426780,
    "endMs": 427360,
    "text": "They're creepers."
  },
  {
    "id": "c138",
    "startMs": 428280,
    "endMs": 429440,
    "text": "They have long thin stems."
  },
  {
    "id": "c139",
    "startMs": 430520,
    "endMs": 433340,
    "text": "They can grow all over a wall in a very short time."
  },
  {
    "id": "c140",
    "startMs": 434060,
    "endMs": 435080,
    "text": "As they grow on the wall,"
  },
  {
    "id": "c141",
    "startMs": 435940,
    "endMs": 437500,
    "text": "their leaves can give it some shade,"
  },
  {
    "id": "c142",
    "startMs": 438380,
    "endMs": 439360,
    "text": "making the wall a bit"
  },
  {
    "id": "c143",
    "startMs": 439640,
    "endMs": 440580,
    "text": "cooler in hot days."
  },
  {
    "id": "c144",
    "startMs": 441780,
    "endMs": 441960,
    "text": "Ah,"
  },
  {
    "id": "c145",
    "startMs": 442480,
    "endMs": 443800,
    "text": "look at the water, ladies."
  },
  {
    "id": "c146",
    "startMs": 444940,
    "endMs": 446060,
    "text": "They are my favourite flowers."
  },
  {
    "id": "c147",
    "startMs": 447460,
    "endMs": 448160,
    "text": "I like them too."
  },
  {
    "id": "c148",
    "startMs": 449280,
    "endMs": 452040,
    "text": "These big leaves look like lovely green umbrellas."
  },
  {
    "id": "c149",
    "startMs": 452860,
    "endMs": 455820,
    "text": "They have a special coating that makes water roll off them."
  },
  {
    "id": "c150",
    "startMs": 456860,
    "endMs": 460760,
    "text": "This keeps the leaves dry and the leaves can float on the water."
  },
  {
    "id": "c151",
    "startMs": 461760,
    "endMs": 461980,
    "text": "Look,"
  },
  {
    "id": "c152",
    "startMs": 462680,
    "endMs": 464040,
    "text": "the pink flowers are so beautiful."
  },
  {
    "id": "c153",
    "startMs": 467580,
    "endMs": 468120,
    "text": "São Pu,"
  },
  {
    "id": "c154",
    "startMs": 468380,
    "endMs": 471720,
    "text": "São Tiang and Sha Tian are visiting the botanical gardens."
  },
  {
    "id": "c155",
    "startMs": 472600,
    "endMs": 473460,
    "text": "Wow,"
  },
  {
    "id": "c156",
    "startMs": 474160,
    "endMs": 475720,
    "text": "the tulips are so beautiful."
  },
  {
    "id": "c157",
    "startMs": 476900,
    "endMs": 478780,
    "text": "The bright colours are really eye-catching."
  },
  {
    "id": "c158",
    "startMs": 479640,
    "endMs": 481620,
    "text": "This one looks like an ice cream cone."
  },
  {
    "id": "c159",
    "startMs": 482560,
    "endMs": 484520,
    "text": "It has a long stem and big leaves."
  },
  {
    "id": "c160",
    "startMs": 485720,
    "endMs": 488240,
    "text": "The long stem helps the tulip stand up straight."
  },
  {
    "id": "c161",
    "startMs": 489280,
    "endMs": 491020,
    "text": "The big leaves can catch a lot of"
  },
  {
    "id": "c162",
    "startMs": 491020,
    "endMs": 492860,
    "text": "sunlight to make food for the plant."
  },
  {
    "id": "c163",
    "startMs": 494160,
    "endMs": 495220,
    "text": "Look at the name tag."
  },
  {
    "id": "c164",
    "startMs": 496420,
    "endMs": 498680,
    "text": "It's called an ice cream tulip."
  },
  {
    "id": "c165",
    "startMs": 499240,
    "endMs": 499800,
    "text": "How lovely!"
  },
  {
    "id": "c166",
    "startMs": 500680,
    "endMs": 503100,
    "text": "The special shape of this tulip may make it"
  },
  {
    "id": "c167",
    "startMs": 503100,
    "endMs": 506180,
    "text": "easier for insects to land on it and help"
  },
  {
    "id": "c168",
    "startMs": 506320,
    "endMs": 507000,
    "text": "with pollination."
  },
  {
    "id": "c169",
    "startMs": 508140,
    "endMs": 508540,
    "text": "Look,"
  },
  {
    "id": "c170",
    "startMs": 508780,
    "endMs": 510180,
    "text": "the wall is covered with plants."
  },
  {
    "id": "c171",
    "startMs": 511600,
    "endMs": 512200,
    "text": "They're creepers."
  },
  {
    "id": "c172",
    "startMs": 513160,
    "endMs": 513360,
    "text": "They have"
  },
  {
    "id": "c173",
    "startMs": 513480,
    "endMs": 514280,
    "text": "long thin stems."
  },
  {
    "id": "c174",
    "startMs": 515320,
    "endMs": 518180,
    "text": "They can grow all over a wall in a very short time."
  },
  {
    "id": "c175",
    "startMs": 518920,
    "endMs": 519600,
    "text": "As they grow on"
  },
  {
    "id": "c176",
    "startMs": 519600,
    "endMs": 519920,
    "text": "the wall,"
  },
  {
    "id": "c177",
    "startMs": 520760,
    "endMs": 522320,
    "text": "their leaves can give it some shade,"
  },
  {
    "id": "c178",
    "startMs": 523200,
    "endMs": 525420,
    "text": "making the wall a bit cooler in hot days."
  },
  {
    "id": "c179",
    "startMs": 526700,
    "endMs": 528640,
    "text": "Ah, look at the water lilies."
  },
  {
    "id": "c180",
    "startMs": 529780,
    "endMs": 530880,
    "text": "They are my favourite flowers."
  },
  {
    "id": "c181",
    "startMs": 532280,
    "endMs": 532980,
    "text": "I like them too."
  },
  {
    "id": "c182",
    "startMs": 533840,
    "endMs": 534140,
    "text": "These big"
  },
  {
    "id": "c183",
    "startMs": 534300,
    "endMs": 536860,
    "text": "leaves look like lovely green umbrellas."
  },
  {
    "id": "c184",
    "startMs": 537660,
    "endMs": 540160,
    "text": "They have a special coating that makes water roll"
  },
  {
    "id": "c185",
    "startMs": 540160,
    "endMs": 540660,
    "text": "off them."
  },
  {
    "id": "c186",
    "startMs": 541680,
    "endMs": 545640,
    "text": "This keeps the leaves dry and the leaves can float on the water."
  },
  {
    "id": "c187",
    "startMs": 546440,
    "endMs": 546820,
    "text": "Look,"
  },
  {
    "id": "c188",
    "startMs": 547380,
    "endMs": 547680,
    "text": "the pink"
  },
  {
    "id": "c189",
    "startMs": 547900,
    "endMs": 548860,
    "text": "flowers are so beautiful."
  }
]
