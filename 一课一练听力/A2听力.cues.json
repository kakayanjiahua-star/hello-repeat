    "id": "c30",
    "startMs": 131080,
    "endMs": 134020,
    "text": "The four o'clock flower is very special."
  },
  {
    "id": "c31",
    "startMs": 135060,
    "endMs": 137800,
    "text": "It has colorful blooms that open in the late afternoon."
  },
  {
    "id": "c32",
    "startMs": 139100,
    "endMs": 140420,
    "text": "It can tell us about the weather."
  },
  {
    "id": "c33",
    "startMs": 141680,
    "endMs": 143660,
    "text": "If the flowers close up early in the morning,"
  },
  {
    "id": "c34",
    "startMs": 144720,
    "endMs": 146180,
    "text": "it is going to be a sunny day."
  },
  {
    "id": "c35",
    "startMs": 147240,
    "endMs": 149580,
    "text": "If the flowers stay open after 6am,"
  },
  {
    "id": "c36",
    "startMs": 150840,
    "endMs": 152860,
    "text": "it will be cloudy or rainy."
  },
  {
    "id": "c37",
    "startMs": 155040,
    "endMs": 158800,
    "text": "These flowers also give off a sweet smell that attracts many insects."
  },
  {
    "id": "c38",
    "startMs": 160900,
    "endMs": 163100,
    "text": "Pine cones react to weather changes too."
  },
  {
    "id": "c39",
    "startMs": 164820,
    "endMs": 168660,
    "text": "They open wide in dry conditions to let their seeds fly away."
  },
  {
    "id": "c40",
    "startMs": 170380,
    "endMs": 171280,
    "text": "But on rainy days,"
