  },
  {
    "id": "c162",
    "startMs": 450140,
    "endMs": 452060,
    "text": "Last Friday was a special day."
  },
  {
    "id": "c163",
    "startMs": 453100,
    "endMs": 455370,
    "text": "Our class took a bus to the Safari Park."
  },
  {
    "id": "c164",
