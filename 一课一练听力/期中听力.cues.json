    "id": "c104",
    "startMs": 328560,
    "endMs": 329360,
    "text": "in the school hall."
  },
  {
    "id": "c105",
    "startMs": 330640,
    "endMs": 333780,
    "text": "We will have it in our own classroom because we want to"
  },
  {
    "id": "c106",
    "startMs": 334000,
    "endMs": 334760,
    "text": "decorate it ourselves."
  },
  {
    "id": "c107",
    "startMs": 335800,
    "endMs": 337520,
    "text": "We are going to play some traditional games."
  },
  {
    "id": "c108",
    "startMs": 338440,
    "endMs": 338680,
    "text": "We thought"
  },
  {
    "id": "c109",
    "startMs": 338680,
    "endMs": 339820,
    "text": "about the dragon dance"
  },
  {
    "id": "c110",
    "startMs": 340520,
    "endMs": 342380,
    "text": "but it's too big for our classroom."
  },
  {
    "id": "c111",
    "startMs": 343320,
    "endMs": 344460,
    "text": "So we will play"
  },
  {
    "id": "c112",
    "startMs": 344660,
    "endMs": 345640,
    "text": "Chinese yo-yo instead."
  },
  {
    "id": "c113",
    "startMs": 346740,
    "endMs": 347380,
    "text": "It will be fun."
  },
  {
    "id": "c114",
    "startMs": 348260,
    "endMs": 350180,
    "text": "For the party please remember to bring"
  },
  {
    "id": "c115",
    "startMs": 350180,
    "endMs": 351840,
    "text": "some fruits to share with everyone."
  },
  {
    "id": "c116",
    "startMs": 352900,
    "endMs": 354820,
    "text": "We will have a big cake so you don't need"
  },
  {
    "id": "c117",
    "startMs": 354840,
    "endMs": 355420,
    "text": "to bring snacks."
  },
  {
    "id": "c118",
    "startMs": 357120,
    "endMs": 359320,
    "text": "After we play games and sing the birthday song,"
  },
  {
    "id": "c119",
    "startMs": 360100,
    "endMs": 361160,
    "text": "we will eat the cake together."
  },
  {
    "id": "c120",
    "startMs": 362340,
    "endMs": 362560,
    "text": "Then,"
  },
  {
    "id": "c121",
    "startMs": 363200,
    "endMs": 364120,
    "text": "as a special activity,"
  },
  {
    "id": "c122",
    "startMs": 365400,
    "endMs": 368340,
    "text": "we will watch a short film about sea animals like whales"
  },
  {
    "id": "c123",
    "startMs": 368340,
    "endMs": 369060,
    "text": "and dolphins."
  },
  {
    "id": "c124",
    "startMs": 370340,
    "endMs": 371650,
    "text": "It will be a wonderful party."
  },
  {
    "id": "c125",
    "startMs": 374430,
    "endMs": 375500,
    "text": "Hello everyone!"
  },
  {
    "id": "c126",
    "startMs": 376920,
    "endMs": 379160,
    "text": "Here is a plan for our class birthday party."
  },
  {
    "id": "c127",
    "startMs": 380560,
    "endMs": 381800,
    "text": "Next Friday afternoon,"
  },
  {
    "id": "c128",
    "startMs": 382360,
    "endMs": 383020,
    "text": "we"
  },
  {
    "id": "c129",
    "startMs": 383040,
    "endMs": 384820,
    "text": "will have a party for Min Min,"
  },
  {
    "id": "c130",
    "startMs": 385100,
    "endMs": 386580,
    "text": "Shao Pu and Shenzhen."
  },
  {
    "id": "c131",
    "startMs": 387420,
    "endMs": 388920,
    "text": "Their birthdays are all in November."
  },
  {
    "id": "c132",
    "startMs": 390220,
    "endMs": 391160,
    "text": "So we celebrate together."
  },
  {
    "id": "c133",
    "startMs": 392140,
    "endMs": 394150,
    "text": "The party will start at 1.30pm,"
  },
  {
    "id": "c134",
    "startMs": 395400,
    "endMs": 396840,
    "text": "but not in the school hall."
  },
  {
    "id": "c135",
    "startMs": 398120,
    "endMs": 398280,
    "text": "We will"
  },
  {
    "id": "c136",
    "startMs": 398280,
    "endMs": 399720,
    "text": "have it in our own classroom"
  },
  {
    "id": "c137",
    "startMs": 400540,
    "endMs": 402260,
    "text": "because we want to decorate it ourselves."
  },
  {
    "id": "c138",
    "startMs": 403240,
    "endMs": 403760,
    "text": "We are going to"
  },
  {
    "id": "c139",
    "startMs": 403760,
    "endMs": 405020,
    "text": "play some traditional games."
  },
  {
    "id": "c140",
    "startMs": 406040,
    "endMs": 407320,
    "text": "We thought about the dragon dance,"
  },
  {
    "id": "c141",
    "startMs": 408040,
    "endMs": 409400,
    "text": "but hurt it's too big for"
  },
  {
    "id": "c142",
    "startMs": 409420,
    "endMs": 409800,
    "text": "our classroom."
  },
  {
    "id": "c143",
    "startMs": 410880,
    "endMs": 410980,
    "text": "So,"
  },
  {
    "id": "c144",
    "startMs": 411520,
    "endMs": 413180,
    "text": "we will play Chinese yo-yo instead."
  },
  {
    "id": "c145",
    "startMs": 414240,
    "endMs": 414860,
    "text": "It will be fun."
  },
  {
    "id": "c146",
