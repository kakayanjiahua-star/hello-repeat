  {
    "id": "c78",
    "startMs": 207360,
    "endMs": 207760,
    "text": "Main main."
  },
  {
    "id": "c79",
    "startMs": 208300,
    "endMs": 212080,
    "text": "What was the most interesting thing you saw in the botanical garden?"
  },
  {
    "id": "c80",
    "startMs": 213320,
    "endMs": 215860,
    "text": "I saw a plant that eats small insects."
  },
  {
    "id": "c81",
    "startMs": 216880,
    "endMs": 218700,
    "text": "It has leaves like a mouth with teeth."
  },
  {
    "id": "c82",
    "startMs": 219600,
    "endMs": 220560,
    "text": "That sounds amazing!"
  },
  {
    "id": "c83",
    "startMs": 221840,
    "endMs": 223960,
    "text": "Did the guy tell you where this plant is called?"
  },
  {
    "id": "c84",
    "startMs": 224620,
    "endMs": 224800,
    "text": "Yes,"
  },
  {
    "id": "c85",
    "startMs": 225360,
    "endMs": 227260,
    "text": "he said it's called a Venus fly trap."
  },
  {
    "id": "c86",
    "startMs": 228240,
    "endMs": 230900,
    "text": "It catches flies and other small bugs for food."
  },
  {
    "id": "c87",
    "startMs": 231900,
    "endMs": 232840,
    "text": "That sounds amazing!"
  },
  {
    "id": "c88",
    "startMs": 235020,
    "endMs": 238920,
    "text": "Question 5. What did Min Min see in the botanical garden?"
  },
  {
    "id": "c89",
    "startMs": 241200,
    "endMs": 245820,
    "text": "Question 6. What do the leaves of the interesting plants look like?"
  },
  {
    "id": "c90",
    "startMs": 246800,
    "endMs": 250580,
    "text": "Dialogue three."
  },
  {
    "id": "c91",
