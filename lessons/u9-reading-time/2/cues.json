[
  {
    "id": "1",
    "startMs": 1120,
    "endMs": 3480,
    "text": "Pages 78 and 79."
  },
  {
    "id": "2",
    "startMs": 4360,
    "endMs": 4840,
    "text": "Reading time"
  },
  {
    "id": "3",
    "startMs": 5980,
    "endMs": 6860,
    "text": "Got a problem?"
  },
  {
    "id": "4",
    "startMs": 7540,
    "endMs": 8340,
    "text": "Ask Simon!"
  },
  {
    "id": "5",
    "startMs": 9980,
    "endMs": 10860,
    "text": "Dear Simon,"
  },
  {
    "id": "6",
    "startMs": 11460,
    "endMs": 14800,
    "text": "I've got a new computer as a gift from my grandpa."
  },
  {
    "id": "7",
    "startMs": 15740,
    "endMs": 20680,
    "text": "My little brother often turns on my computer and deletes my photos."
  },
  {
    "id": "8",
    "startMs": 21400,
    "endMs": 22440,
    "text": "It's really bad."
  },
  {
    "id": "9",
    "startMs": 22940,
    "endMs": 23960,
    "text": "What should I do?"
  },
  {
    "id": "10",
    "startMs": 24780,
    "endMs": 25880,
    "text": "From Star 88"
  },
  {
    "id": "11",
    "startMs": 28600,
    "endMs": 30400,
    "text": "Hi Star 88!"
  },
  {
    "id": "12",
    "startMs": 31100,
    "endMs": 33420,
    "text": "You need to set a power-on password."
  },
  {
    "id": "13",
    "startMs": 34400,
    "endMs": 40160,
    "text": "You can set a password by using eight different letters, numbers and symbols."
  },
  {
    "id": "14",
    "startMs": 41780,
    "endMs": 44940,
    "text": "Keep it to yourself and don't tell anyone."
  },
  {
    "id": "15",
    "startMs": 45980,
    "endMs": 46460,
    "text": "Good luck!"
  },
  {
    "id": "16",
    "startMs": 47300,
    "endMs": 47420,
    "text": "Simon"
  },
  {
    "id": "17",
    "startMs": 51300,
    "endMs": 52120,
    "text": "Dear Simon,"
  },
  {
    "id": "18",
    "startMs": 52940,
    "endMs": 55880,
    "text": "I carelessly dropped some milk on my keyboard."
  },
  {
    "id": "19",
    "startMs": 56940,
    "endMs": 58660,
    "text": "Now it does not work."
  },
  {
    "id": "20",
    "startMs": 60340,
    "endMs": 61520,
    "text": "I am worried."
  },
  {
    "id": "21",
    "startMs": 62280,
    "endMs": 64000,
    "text": "Is my computer broken?"
  },
  {
    "id": "22",
    "startMs": 65360,
    "endMs": 66880,
    "text": "I don't know what to do."
  },
  {
    "id": "23",
    "startMs": 67620,
    "endMs": 68560,
    "text": "Please help me!"
  },
  {
    "id": "24",
    "startMs": 69820,
    "endMs": 71080,
    "text": "From Star 99"
  },
  {
    "id": "25",
    "startMs": 74400,
    "endMs": 75860,
    "text": "Hi Star 99!"
  },
  {
    "id": "26",
    "startMs": 76840,
    "endMs": 80900,
    "text": "A little milk on the keyboard does not matter too much."
  },
  {
    "id": "27",
    "startMs": 82260,
    "endMs": 83920,
    "text": "Clean the keyboard first."
  },
  {
    "id": "28",
    "startMs": 85000,
    "endMs": 86240,
    "text": "And leave it to dry."
  },
  {
    "id": "29",
    "startMs": 87320,
    "endMs": 92960,
    "text": "If you are worried, you can ask your parents to help you check the computer."
  },
  {
    "id": "30",
    "startMs": 94200,
    "endMs": 101200,
    "text": "Remember, do not have milk or other drinks while using the computer in the future."
  },
  {
    "id": "31",
    "startMs": 103160,
    "endMs": 103320,
    "text": "Simon"
  }
]
