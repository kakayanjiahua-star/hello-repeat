[
  {
    "id": "1",
    "startMs": 16280,
    "endMs": 20140,
    "text": "Boys and girls, what can we do to live a greener life?"
  },
  {
    "id": "2",
    "startMs": 21160,
    "endMs": 23880,
    "text": "I turn off the tap when I brush my teeth."
  },
  {
    "id": "3",
    "startMs": 24680,
    "endMs": 25020,
    "text": "Good boy!"
  },
  {
    "id": "4",
    "startMs": 26100,
    "endMs": 29440,
    "text": "Every time we do this, we save water."
  },
  {
    "id": "5",
    "startMs": 30500,
    "endMs": 32880,
    "text": "I use both sides of the paper."
  },
  {
    "id": "6",
    "startMs": 33740,
    "endMs": 33940,
    "text": "Good."
  },
  {
    "id": "7",
    "startMs": 35020,
    "endMs": 37660,
    "text": "You see, paper is made from wood."
  },
  {
    "id": "8",
    "startMs": 38480,
    "endMs": 41980,
    "text": "Use less paper and we can save a lot of trees."
  },
  {
    "id": "13",
    "startMs": 47460,
    "endMs": 49780,
    "text": "I like walking to school every day."
  },
  {
    "id": "14",
    "startMs": 50320,
    "endMs": 52660,
    "text": "It is a good way to reduce air pollution."
  },
  {
    "id": "15",
    "startMs": 53640,
    "endMs": 57140,
    "text": "Yes, and it’s a healthy habit too."
  },
  {
    "id": "16",
    "startMs": 58540,
    "endMs": 61340,
    "text": "I plant seeds and watch them grow."
  },
  {
    "id": "17",
    "startMs": 64300,
    "endMs": 64880,
    "text": "Good idea."
  },
  {
    "id": "18",
    "startMs": 65720,
    "endMs": 68140,
    "text": "Plants help keep the air clean and fresh."
  }
]
