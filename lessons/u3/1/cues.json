[
  {
    "id": "1",
    "startMs": 27600,
    "endMs": 30320,
    "text": "Wow, the tulips are so beautiful!"
  },
  {
    "id": "2",
    "startMs": 32520,
    "endMs": 35160,
    "text": "This one looks like an ice cream cone."
  },
  {
    "id": "3",
    "startMs": 35180,
    "endMs": 37940,
    "text": "It has a long stem and big leaves."
  },
  {
    "id": "4",
    "startMs": 39720,
    "endMs": 41040,
    "text": "Look at the name tag."
  },
  {
    "id": "5",
    "startMs": 41200,
    "endMs": 43340,
    "text": "It’s called an ice cream tulip."
  },
  {
    "id": "6",
    "startMs": 44280,
    "endMs": 44760,
    "text": "How lovely!"
  },
  {
    "id": "7",
    "startMs": 51200,
    "endMs": 55160,
    "text": "The wall is covered with plants."
  },
  {
    "id": "8",
    "startMs": 55160,
    "endMs": 56140,
    "text": "They’re creepers."
  },
  {
    "id": "9",
    "startMs": 57300,
    "endMs": 59480,
    "text": "They have short, thick stems."
  },
  {
    "id": "10",
    "startMs": 59820,
    "endMs": 64300,
    "text": "They can grow all over a wall in a very short time."
  },
  {
    "id": "12",
    "startMs": 69700,
    "endMs": 76060,
    "text": "That plant has special leaves, like a mouth with many teeth!"
  },
  {
    "id": "13",
    "startMs": 76060,
    "endMs": 77420,
    "text": "It’s a meat-eating plant."
  },
  {
    "id": "14",
    "startMs": 78460,
    "endMs": 80040,
    "text": "It eats small insects."
  },
  {
    "id": "15",
    "startMs": 86510,
    "endMs": 89510,
    "text": "That’s my favourite flower."
  },
  {
    "id": "16",
    "startMs": 89770,
    "endMs": 91370,
    "text": "Ah, water lilies."
  },
  {
    "id": "17",
    "startMs": 92430,
    "endMs": 96810,
    "text": "These broad leaves look like lovely green umbrellas."
  },
  {
    "id": "18",
    "startMs": 98050,
    "endMs": 100430,
    "text": "Look, the pink flowers are so beautiful!"
  },
  {
    "id": "19",
    "startMs": 101710,
    "endMs": 104910,
    "text": "The flowers grow from the mud under the water."
  },
  {
    "id": "20",
    "startMs": 105510,
    "endMs": 107970,
    "text": "But they are still clean and beautiful."
  },
  {
    "id": "21",
    "startMs": 108950,
    "endMs": 110170,
    "text": "Isn’t it amazing?"
  }
]
