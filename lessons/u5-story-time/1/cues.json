[
  {
    "id": "c1",
    "startMs": 6760,
    "endMs": 17040,
    "text": "1. One day a man came to see Hua Tuo."
  },
  {
    "id": "c2",
    "startMs": 18220,
    "endMs": 19580,
    "text": "When Hua Tuo helped him,"
  },
  {
    "id": "c3",
    "startMs": 20140,
    "endMs": 20560,
    "text": "he cried,"
  },
  {
    "id": "c4",
    "startMs": 21300,
    "endMs": 22320,
    "text": "Ouch, Ouch."
  },
  {
    "id": "c5",
    "startMs": 23860,
    "endMs": 25380,
    "text": "How can I reduce his pain?"
  },
  {
    "id": "c6",
    "startMs": 26920,
    "endMs": 27600,
    "text": "Hua Tuo thought."
  },
  {
    "id": "c7",
    "startMs": 30260,
    "endMs": 30520,
    "text": "Two."
  },
  {
    "id": "c8",
    "startMs": 32380,
    "endMs": 34850,
    "text": "Then, another man came to see Hua Tuo."
  },
  {
    "id": "c9",
    "startMs": 35740,
    "endMs": 37480,
    "text": "He was drunk and broke his leg."
  },
  {
    "id": "c10",
    "startMs": 38520,
    "endMs": 39400,
    "text": "Hua Tuo helped him."
  },
  {
    "id": "c11",
    "startMs": 40300,
    "endMs": 42180,
    "text": "He was asleep and did not feel pain."
  },
  {
    "id": "c12",
    "startMs": 43540,
    "endMs": 44660,
    "text": "Hua Tuo had an idea."
  },
  {
    "id": "c13",
    "startMs": 45580,
    "endMs": 48280,
    "text": "I need some medicine to make people sleep."
  },
  {
    "id": "c14",
    "startMs": 49640,
    "endMs": 52120,
    "text": "Three."
  },
  {
    "id": "c15",
    "startMs": 53740,
    "endMs": 54440,
    "text": "Some days later,"
  },
  {
    "id": "c16",
    "startMs": 54540,
    "endMs": 58420,
    "text": "a mother came in with a child in her arms."
  },
  {
    "id": "c17",
    "startMs": 59740,
    "endMs": 64700,
    "text": "The child ate some white flowers and his mother couldn't wake him up."
  },
  {
    "id": "c18",
    "startMs": 66160,
    "endMs": 67140,
    "text": "But an hour later,"
  },
  {
    "id": "c19",
    "startMs": 67680,
    "endMs": 70040,
    "text": "the boy woke up by himself."
  },
  {
    "id": "c20",
    "startMs": 72880,
    "endMs": 75080,
    "text": "The white flower was tromadsu."
  },
  {
    "id": "c21",
    "startMs": 76540,
    "endMs": 76990,
    "text": "With this plant,"
  },
  {
    "id": "c22",
    "startMs": 77980,
    "endMs": 81640,
    "text": "Hua Tuo made a medicine called Mafei San."
  },
  {
    "id": "c23",
    "startMs": 83460,
    "endMs": 86640,
    "text": "It helped many people feel less pain."
  }
]