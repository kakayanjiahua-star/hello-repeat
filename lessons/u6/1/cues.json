    "text": "Well done, Shenshen!"
  },
  {
    "id": "2",
    "startMs": 20880,
    "endMs": 21860,
    "text": "Thank you, Minmin."
  },
  {
    "id": "4",
    "startMs": 25860,
    "endMs": 27400,
    "text": "You were shy and quiet."
  },
  {
    "id": "5",
    "startMs": 27400,
    "endMs": 29460,
    "text": "But you are so confident today."
  },
  {
    "id": "6",
    "startMs": 30640,
    "endMs": 36240,
    "text": "Yeah, I used to be very nervous to speak in front of my schoolmates."
  },
  {
    "id": "7",
    "startMs": 40440,
    "endMs": 42540,
    "text": "You are now a good storyteller."
  },
  {
    "id": "8",
    "startMs": 43300,
    "endMs": 44360,
    "text": "How did you make it?"
  },
  {
    "id": "10",
    "startMs": 45180,
    "endMs": 48660,
    "text": "I learned from videos and did a lot of practice."
  },
  {
    "id": "12",
    "startMs": 53520,
    "endMs": 55960,
    "text": "I told stories to my family."
  },
  {
    "id": "13",
    "startMs": 56560,
    "endMs": 58740,
    "text": "They made videos for me and gave me advice."
  },
  {
    "id": "14",
    "startMs": 59600,
    "endMs": 60320,
    "text": "I see."
  },
  {
    "id": "15",
    "startMs": 60480,
    "endMs": 62920,
    "text": "Love and practice make a better you."
  }
