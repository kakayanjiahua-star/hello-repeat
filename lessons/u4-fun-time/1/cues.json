[
  {
    "id": "c1",
    "startMs": 1320,
    "endMs": 1780,
    "text": "Fun time."
  },
  {
    "id": "c2",
    "startMs": 3320,
    "endMs": 4180,
    "text": "A welcome letter."
  },
  {
    "id": "c3",
    "startMs": 7380,
    "endMs": 7980,
    "text": "Dear children,"
  },
  {
    "id": "c4",
    "startMs": 8780,
    "endMs": 10540,
    "text": "welcome to the Safari Park."
  },
  {
    "id": "c5",
    "startMs": 11960,
    "endMs": 15820,
    "text": "You can find out the interesting habits of animals like tigers,"
  },
  {
    "id": "c6",
    "startMs": 16580,
    "endMs": 17780,
    "text": "lions and elephants."
  },
  {
    "id": "c7",
    "startMs": 19620,
    "endMs": 22200,
    "text": "You can get close to sea animals like whales."
  },
  {
    "id": "c8",
    "startMs": 23800,
    "endMs": 25380,
    "text": "Come and get to know these animals."
  },
  {
    "id": "c9",
    "startMs": 26880,
    "endMs": 31020,
    "text": "You can take a safari tour and enjoy other fun activities here."
  },
  {
    "id": "c10",
    "startMs": 32420,
    "endMs": 33180,
    "text": "What to wear?"
  },
  {
    "id": "c11",
    "startMs": 34520,
    "endMs": 35740,
    "text": "Closed toe shoes,"
  },
  {
    "id": "c12",
    "startMs": 36700,
    "endMs": 38900,
    "text": "a hat and warm clothes."
  },
  {
    "id": "c13",
    "startMs": 40460,
    "endMs": 41040,
    "text": "What to bring?"
  },
  {
    "id": "c14",
    "startMs": 42660,
    "endMs": 44160,
    "text": "Water and an umbrella."
  },
  {
    "id": "c15",
    "startMs": 45580,
    "endMs": 47100,
    "text": "Safari Park Kids Club."
  },
  {
    "id": "c16",
    "startMs": 49940,
    "endMs": 53020,
    "text": "A. Listen and choose."
  },
  {
    "id": "c17",
    "startMs": 54580,
    "endMs": 57440,
    "text": "Let's go to the safari park this weekend."
  },
  {
    "id": "c18",
    "startMs": 58880,
    "endMs": 59300,
    "text": "Hooray!"
  },
  {
    "id": "c19",
    "startMs": 60320,
    "endMs": 61840,
    "text": "Are they alliance and tigers?"
  },
  {
    "id": "c20",
    "startMs": 63060,
    "endMs": 64820,
    "text": "Can I see giraffes and elephants?"
  },
  {
    "id": "c21",
    "startMs": 66700,
    "endMs": 67280,
    "text": "Sure,"
  },
  {
    "id": "c22",
    "startMs": 67840,
    "endMs": 67960,
    "text": "sissy."
  },
  {
    "id": "c23",
    "startMs": 68800,
    "endMs": 70080,
    "text": "You can see all of them."
  },
  {
    "id": "c24",
    "startMs": 70860,
    "endMs": 73250,
    "text": "And we can visit lovely pandas."
  },
  {
    "id": "c25",
    "startMs": 74440,
    "endMs": 75560,
    "text": "Can I feed the animals?"
  },
  {
    "id": "c26",
    "startMs": 76580,
    "endMs": 77040,
    "text": "No,"
  },
  {
    "id": "c27",
    "startMs": 77760,
    "endMs": 78640,
    "text": "I'm afraid not."
  },
  {
    "id": "c28",
    "startMs": 79700,
    "endMs": 82060,
    "text": "It is not kind to the animals."
  },
  {
    "id": "c29",
    "startMs": 83140,
    "endMs": 83740,
    "text": "Okay."
  },
  {
    "id": "c30",
    "startMs": 85060,
    "endMs": 86320,
    "text": "What can we do there then?"
  },
  {
    "id": "c31",
    "startMs": 87840,
    "endMs": 89600,
    "text": "We can take a safari tour."
  },
  {
    "id": "c32",
    "startMs": 91100,
    "endMs": 94080,
    "text": "We can also watch a short film about sea animals."
  },
  {
    "id": "c33",
    "startMs": 96720,
    "endMs": 97280,
    "text": "Look here."
  },
  {
    "id": "c34",
    "startMs": 98140,
    "endMs": 101600,
    "text": "There isn't letter from the Safari Park Kids Club."
  },
  {
    "id": "c35",
    "startMs": 102480,
    "endMs": 103320,
    "text": "Let's read it."
  },
  {
    "id": "c36",
    "startMs": 104620,
    "endMs": 105220,
    "text": "Okay."
  }
]
