[
  {
    "id": "1",
    "startMs": 13440,
    "endMs": 18400,
    "text": "Mr Zhong, is this Shaolin kung fu?"
  },
  {
    "id": "2",
    "startMs": 20320,
    "endMs": 23260,
    "text": "This is changquan — Long Fist."
  },
  {
    "id": "3",
    "startMs": 23260,
    "endMs": 26420,
    "text": "It’s the mother of many kung fu styles."
  },
  {
    "id": "4",
    "startMs": 27760,
    "endMs": 29620,
    "text": "Oh, I see."
  },
  {
    "id": "5",
    "startMs": 29780,
    "endMs": 32480,
    "text": "Many kung fu styles come from Long Fist?"
  },
  {
    "id": "6",
    "startMs": 33760,
    "endMs": 34460,
    "text": "That’s right!"
  },
  {
    "id": "7",
    "startMs": 36400,
    "endMs": 37380,
    "text": "It’s amazing!"
  },
  {
    "id": "8",
    "startMs": 38600,
    "endMs": 40520,
    "text": "There are twelve kinds of actions."
  },
  {
    "id": "9",
    "startMs": 44100,
    "endMs": 47060,
    "text": "Look, what does this look like?"
  },
  {
    "id": "10",
    "startMs": 49080,
    "endMs": 49640,
    "text": "A tree?"
  },
  {
    "id": "11",
    "startMs": 50660,
    "endMs": 52340,
    "text": "Correct."
  },
  {
    "id": "12",
    "startMs": 52480,
    "endMs": 55180,
    "text": "Stand like a pine tree."
  },
  {
    "id": "13",
    "startMs": 55300,
    "endMs": 56620,
    "text": "Very strong and proud."
  },
  {
    "id": "14",
    "startMs": 58120,
    "endMs": 59060,
    "text": "Look at us."
  },
  {
    "id": "15",
    "startMs": 59240,
    "endMs": 60380,
    "text": "Three straight trees!"
  },
  {
    "id": "16",
    "startMs": 61560,
    "endMs": 63120,
    "text": "Excellent!"
  },
  {
    "id": "17",
    "startMs": 63200,
    "endMs": 64680,
    "text": "Let me show you another one."
  },
  {
    "id": "18",
    "startMs": 66060,
    "endMs": 67340,
    "text": "What does this look like?"
  },
  {
    "id": "19",
    "startMs": 68780,
    "endMs": 69720,
    "text": "I know!"
  },
  {
    "id": "20",
    "startMs": 69720,
    "endMs": 71860,
    "text": "Sit like a bell."
  },
  {
    "id": "21",
    "startMs": 71860,
    "endMs": 73420,
    "text": "Clever girl!"
  },
  {
    "id": "22",
    "startMs": 73440,
    "endMs": 75100,
    "text": "How about this?"
  },
  {
    "id": "23",
    "startMs": 75520,
    "endMs": 77300,
    "text": "Wow, you move so fast!"
  },
  {
    "id": "24",
    "startMs": 78500,
    "endMs": 79700,
    "text": "As fast as the wind."
  },
  {
    "id": "25",
    "startMs": 80860,
    "endMs": 83940,
    "text": "I use all my strength for every action."
  },
  {
    "id": "26",
    "startMs": 85100,
    "endMs": 86860,
    "text": "That’s why it’s so fast!"
  }
]
